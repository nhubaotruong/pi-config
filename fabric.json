{
  "configVersion": 3,
  "executor": {
    "timeoutMs": 600000,
    "memoryLimitBytes": 4294967296,
    "maxOutputChars": 100000
  },
  "mcp": {
    "callTimeoutMs": 300000
  },
  "capture": {
    "keepVisible": [
      "fabric_exec"
    ]
  },
  "prewalk": {
    "mode": "in-place",
    "detectShellWrites": true,
    "compactOnReturn": true,
    "alwaysRearm": false
  }
}
