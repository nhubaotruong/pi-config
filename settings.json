    "npm:pi-zentui",
    "npm:pi-rtk-optimizer",
    "git:github.com/EveryInc/compound-engineering-plugin",
    "npm:pi-manage-todo-list",
    "npm:pi-subagents",
    "npm:pi-hashline-edit-pro",
    "npm:pi-blackhole"
