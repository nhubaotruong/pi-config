{
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:pi-mcp-adapter",
    "npm:pi-lens",
    "npm:pi-readseek",
    "npm:pi-agent-browser-native",
    "npm:cc-safety-net",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-cache-optimizer",
    "npm:pi-zentui",
    "npm:@juicesharp/rpiv-todo",
    "git:github.com/obra/superpowers",
    "npm:browser-goblin",
    "npm:@upstash/context7-pi",
    "npm:pi-web-access",
    "git:github.com/elpapi42/pi-codegraph",
    "npm:pi-ollama-cloud",
    "npm:@ayulab/pi-rewind",
    "npm:pi-exit",
    "npm:@juicesharp/rpiv-args",
    "npm:@juicesharp/rpiv-advisor",
    "npm:pi-image-tools",
    "npm:pi-rtk-optimizer",
    "npm:pi-startup-redraw-fix",
    "npm:pi-opencode-go-cache",
    "npm:@getpipher/vision",
    "npm:@pi-unipi/notify",
    "npm:pi-hodor"
  ],
  "lastChangelogVersion": "0.81.1",
  "theme": "dark",
  "showHardwareCursor": true,
  "outputPad": 0,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "always",
  "defaultThinkingLevel": "high",
  "defaultProvider": "opencode",
  "defaultModel": "mimo-v2.5-free",
  "hideThinkingBlock": true,
  "editorPaddingX": 1,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 64000
  },
  "showCacheMissNotices": true,
  "readseek": {
    "replacedTools": [
      "read",
      "edit",
      "write",
      "grep"
    ],
    "imageMode": "auto",
    "syntaxValidation": "warn",
    "timeoutMs": 120000
  }
}