  "quietStartup": true,
  "showCacheMissNotices": false,
  "showHardwareCursor": true,
  "subagents": {
    "defaultThinking": "max",
    "agentOverrides": {
      "sdd-init": {
        "model": "inherit"
      },
      "Designer": {
        "thinking": "max"
      },
      "oracle": {
        "thinking": "max"
      },
      "worker": {
        "thinking": "max"
      },
      "reviewer": {
        "thinking": "max"
      },
      "researcher": {
        "thinking": "max"
      },
      "scout": {
        "thinking": "max"
      },
      "evidence-auditor": {
        "thinking": "max"
      }
    }
  },
  "theme": "dark",
  "tuiMode": "regular",
  "terminal": {
    "clearOnShrink": true,
    "showTerminalProgress": true
  }
