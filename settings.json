    "npm:@upstash/context7-pi",
    "npm:pi-web-access",
    "git:github.com/elpapi42/pi-codegraph",
    "npm:pi-ollama-cloud",
    "npm:pi-exit",
    "npm:@juicesharp/rpiv-args",
    "npm:pi-opencode-go-cache",
    "npm:@pi-unipi/notify",
    "npm:pi-commandcode-provider",
    "npm:pi-extension-nvidia-nim",
    "npm:@realvendex/pi-token-router",
    "npm:@juicesharp/rpiv-btw",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@getpipher/vision",
